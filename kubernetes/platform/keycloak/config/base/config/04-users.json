{
  "enabled": true,
  "realm": "rdxcluster",
  "users": [
    {
      "username": "$(env:CLUSTER_ADMIN_USERNAME)",
      "firstName": "$(env:CLUSTER_ADMIN_FIRSTNAME)",
      "lastName": "$(env:CLUSTER_ADMIN_LASTNAME)",
      "email": "admin@$(env:CLUSTER_DOMAIN)",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "$(env:CLUSTER_ADMIN_PASSWORD)"
        }
      ],
      "realmRoles": ["default-roles-rdxcluster"],
      "groups": ["admin"]
    }
  ]
}
